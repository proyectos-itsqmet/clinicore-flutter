# =============================================================================
# CliniCore — environment template
# =============================================================================
#
# Copy this file to `.env` in the project root:
#
#   cp .env.example .env        # macOS / Linux
#   Copy-Item .env.example .env # Windows PowerShell
#
# `.env` is gitignored (`*.env`), so it never leaves your machine. This
# template is committed so a new clone knows what to fill in.
#
# -----------------------------------------------------------------------------
# THE `.env` FILE IS NOT OPTIONAL
# -----------------------------------------------------------------------------
# `pubspec.yaml` declares `.env` as a Flutter ASSET. A declared asset that does
# not exist is a BUILD failure, not a warning — a fresh clone cannot run until
# the file exists, even empty. `main.dart` tolerates an unreadable `.env` at
# RUNTIME, which is a different thing and does not save the build.
#
# =============================================================================


# -----------------------------------------------------------------------------
# API_BASE_URL — the only key this app reads
# -----------------------------------------------------------------------------
# Base URL of the QMS API, WITHOUT a trailing slash and WITHOUT a path suffix.
# Endpoints sit directly under the host, because the Spring Boot service runs
# on `server.port=8080` with no context path:
#
#   POST {API_BASE_URL}/auth/mobile/login-patient
#
# Leave it unset and `AppConfig` falls back per platform (Android -> 10.0.2.2,
# everything else -> localhost). Setting it explicitly is still better: the
# fallback cannot know you moved the backend to another machine.
#
# Pick the ONE line that matches where you are running the app:

# Android emulator — 10.0.2.2 is the emulator's route to YOUR machine's
# loopback. `localhost` inside an emulator is the emulator itself, which is the
# single most common reason "the app cannot reach my backend" looks like a
# server problem.
API_BASE_URL=http://10.0.2.2:8080

# iOS simulator, macOS, Windows, Linux, or Chrome — these share the host's
# network stack, so loopback is correct.
# API_BASE_URL=http://localhost:8080

# Physical device on the same Wi-Fi — use your machine's LAN address
# (`ipconfig` on Windows, `ifconfig`/`ip addr` elsewhere).
#
# TWO extra steps are required for this one, and skipping either gives you a
# timeout with no explanation:
#
#   1. Add the SAME address to
#      `android/app/src/main/res/xml/network_security_config.xml`. Android 9+
#      blocks cleartext HTTP, and that file whitelists hosts one by one — a
#      LAN IP that is not listed there is blocked by the OS before Dio ever
#      opens a socket.
#   2. Allow port 8080 through your machine's firewall. Windows Defender
#      blocks inbound 8080 by default, so the phone's request never lands.
#
# API_BASE_URL=http://192.168.1.100:8080

# Physical device over USB with `adb reverse tcp:8080 tcp:8080` — the port is
# tunnelled, so loopback works and no firewall rule is needed.
# API_BASE_URL=http://localhost:8080
