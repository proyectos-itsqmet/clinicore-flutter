<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP, allowed for the development backend ONLY.

  Android 9 (API 28) blocks plain HTTP by default. That is correct and this
  file does not undo it: `base-config` keeps the block for everything, and the
  `domain-config` below opens it for exactly three names — the addresses a
  developer's own machine answers on.

  Why this and not `android:usesCleartextTraffic="true"` on <application>:
  that flag disables the protection for the WHOLE app, in every build, for
  every host. In an app that carries medical records it would mean any
  misconfigured URL silently downgrades to unencrypted. Here, a request to a
  real host over http still fails — loudly, at the right time.

  `10.0.2.2` is the Android emulator's route to the host machine's loopback.
  Inside the emulator, `localhost` is the emulator itself, which is the single
  most common reason "the app cannot reach my backend" looks like a server
  problem. `localhost` and `127.0.0.1` are listed for a physical device
  connected through `adb reverse`.

  REMOVE THIS FILE (and the manifest attribute that points at it) once the QMS
  API is served over HTTPS. It is a development affordance, not a setting.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>

        <!--
          PHYSICAL DEVICE over Wi-Fi: add your machine's LAN address here and
          use the same one in `.env` as API_BASE_URL.

          There is no wildcard to reach for. Android matches `<domain>` by exact
          name or by suffix (`includeSubdomains`) — it does NOT accept CIDR
          ranges or globs, so `192.168.*` and `192.168.0.0/16` are both invalid
          and silently match nothing. One line per address is the only way.

          Without this line the OS refuses the socket before Dio opens it, so
          the app reports a connection timeout and the backend logs show no
          request at all — it looks exactly like a server that is down.

          Not needed for `adb reverse tcp:8080 tcp:8080`: that tunnels the port,
          so the app talks to `localhost`, which is already listed above.
        -->
        <!-- <domain includeSubdomains="false">192.168.1.100</domain> -->
    </domain-config>
</network-security-config>
